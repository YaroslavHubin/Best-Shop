{
  "name": "project-template",
  "version": "1.0.0",
  "description": "Capstone Project Template ",
  "repository": {
    "type": "git",
    "url": "https://autocode.git.epam.com/campus_javascript/capstone-project/project-template.git"
  },
  "license": "ISC",
  "author": "Yaroslav Hubin",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "compile": "sass src/scss:dist/css --no-source-map",
    "build": "npm run compile",
    "watch": "sass --watch src/scss:dist/css --no-source-map",
    "serve": "live-server . --open=src/index.html",
    "dev": "npm run compile && concurrently -k 'npm:watch' 'npm:serve'",
    "lint": "npm run lint:js && npm run lint:scss",
    "lint:js": "eslint \"src/js/**/*.js\"",
    "lint:scss": "stylelint \"src/scss/**/*.scss\" --config stylelint.config.mjs",
    "lint:fix": "eslint \"src/js/**/*.js\" --fix && stylelint \"src/scss/**/*.scss\" --config stylelint.config.mjs --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "live-server": "^1.2.2",
    "sass": "^1.108.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^18.0.0"
  }
}
